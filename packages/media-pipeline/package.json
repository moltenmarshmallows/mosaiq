{
  "name": "@vmp/media-pipeline",
  "version": "2.0.0",
  "private": true,
  "description": "VMP media VM: SVT Encore transcoding orchestration, Shaka HLS packaging, R2 upload, podcast MP3",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "build": "npm run build --workspace=@vmp/storage && tsc -p tsconfig.json",
    "start": "npm run build && node ./dist/supervisor.js",
    "supervisor": "npm run build && node ./dist/supervisor.js",
    "pipeline": "npm run build && node ./dist/pipeline_watch.js",
    "coordinator:up": "docker compose -f docker-compose.coordinator.yml --env-file .env up -d",
    "coordinator:down": "docker compose -f docker-compose.coordinator.yml down",
    "worker:up": "docker compose -f docker-compose.worker.yml --env-file .env up -d",
    "worker:down": "docker compose -f docker-compose.worker.yml down",
    "encore:doctor": "npm run build && node ./dist/pipelineDoctor.js",
    "migrate:r2-video-prefixes": "bash ./bin/video_id_r2_prefix_migrate.sh",
    "render": "npm run build && node ./dist/render_podcast_preview_mp3.js",
    "ttp-report": "node ./scripts/ttp-report.mjs",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@vmp/storage": "*",
    "redis": "^6.2.1"
  }
}
