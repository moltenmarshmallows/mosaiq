{
  "title": "VMP Media Pipeline",
  "uid": "vmp-media-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live workers",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "vmp_workers_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queue depth",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "vmp_pipeline_queue_depth", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Encore up",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "vmp_encore_up", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redis up",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "vmp_redis_up", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pipeline alive",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "vmp_pipeline_child_alive", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Jobs failed",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "vmp_pipeline_jobs_failed_total", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Workers by backend",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "vmp_workers", "legendFormat": "{{backend}}", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Active jobs by stage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "vmp_pipeline_active_jobs", "legendFormat": "{{stage}}", "refId": "A" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Encore queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "vmp_encore_queue_depth", "legendFormat": "queue {{queue}}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Last TTP (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "vmp_ttp_last_minimal_ms", "legendFormat": "minimal", "refId": "A" },
        { "expr": "vmp_ttp_last_full_ms", "legendFormat": "full", "refId": "B" },
        { "expr": "vmp_ttp_last_total_ms", "legendFormat": "total", "refId": "C" }
      ]
    }
  ]
}
