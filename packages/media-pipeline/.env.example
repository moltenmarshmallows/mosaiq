# Copy to .env next to the compose files before `docker compose up`.
# Compose fails fast (env:VAR:?msg) if required values are missing — no placeholders ship.

# ── Secrets (required, both composes) ──────────────────────────────────────
# base64url only (A–Z a–z 0–9 - _) — embedded in encore-packager CALLBACK_URL
VMP_PACKAGER_SECRET=replace-with-base64url-secret
VMP_WEBHOOK_SECRET=replace-with-d1-podcast_rebuild_webhook_secret
VMP_SUPERVISOR_DASHBOARD_SECRET=replace-with-long-random-string
# Shared coordinator↔worker token (worker heartbeat auth)
VMP_WORKER_TOKEN=replace-with-long-random-string
# Redis --requirepass — remote workers reach the coordinator's Redis over LAN;
# set the same value in every worker's .env.
VMP_REDIS_PASSWORD=replace-with-long-random-string

# ── VMP API callbacks ──────────────────────────────────────────────────────
VMP_API_BASE_URL=https://staging.app.mosaiq.video
VMP_API_PIPELINE_SECRET=replace-with-worker-pipeline-secret

# ── Object storage (B2 via S3 API — packager + supervisor sidecars) ────────
STORAGE_PROVIDER=b2
PACKAGE_OUTPUT_FOLDER=s3://your-b2-bucket/videos
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
AWS_ACCESS_KEY_ID=your-b2-key-id
AWS_SECRET_ACCESS_KEY=your-b2-application-key
AWS_REGION=eu-central-003
S3_FORCE_PATH_STYLE=1
# Aliases (Compose maps B2_* into AWS_* when AWS_* unset):
# B2_BUCKET_NAME=your-b2-bucket
# B2_ACCESS_KEY_ID=...  B2_SECRET_ACCESS_KEY=...  B2_S3_ENDPOINT=...  B2_REGION=...

# ── Media plane ────────────────────────────────────────────────────────────
# Host directory mounted at /media in EVERY encode/packager container —
# coordinator and all workers must see the same tree (bind mount on one host,
# NFS export across LAN).
# ENCORE_MEDIA_MOUNT=/mnt

# ── Coordinator networking ─────────────────────────────────────────────────
# Address-only values — Compose appends the ports itself.
# Dashboard + webhooks + TUS proxy + metrics. Loopback is safe for same-host;
# remote workers need heartbeat reachability → bind LAN and firewall.
# VMP_UI_BIND=127.0.0.1
# Redis for remote workers — NEVER 0.0.0.0 on a public host. Redis auth IS
# enabled (--requirepass); share VMP_REDIS_PASSWORD with every worker's .env.
# VMP_REDIS_BIND=127.0.0.1
# Encore API (workers don't call it; loopback fine)
# ENCORE_HTTP_BIND=127.0.0.1

# ── Worker node ────────────────────────────────────────────────────────────
# Coordinator hostname/IP as seen by this worker. Unset = same-host shared
# `vmp-media` docker network (service names resolve).
# VMP_COORDINATOR=
# VMP_WORKER_ID=            # default: hostname
# VMP_WORKER_HEARTBEAT_S=30
# VAAPI_DEVICE=/dev/dri/renderD128
# NVIDIA_VISIBLE_DEVICES=all

# ── Scheduling ─────────────────────────────────────────────────────────────
# job       — one Encore job encodes the whole ABR ladder (default)
# renditions — one Encore job per resolution; 1080/720/480 run on different
#              workers in parallel; packager merges via an aggregate job doc.
# VMP_LADDER_SPLIT=job
# URL packagers use to fetch aggregate docs — must be reachable by EVERY
# packager (default http://vmp-supervisor:8788 for same-network packagers).
# PACKAGER_SUPERVISOR_BASE_URL=http://media.lan:8788

# ── Uploads (tusd via supervisor /vmp/uploads) ─────────────────────────────
# TUSD_MAX_SIZE_BYTES=21474836480

# ── Observability (--profile observability) ────────────────────────────────
# PROMETHEUS_BIND=127.0.0.1:9090
# GRAFANA_BIND=127.0.0.1:3000
# GRAFANA_ADMIN_PASSWORD=admin

# ── Images ─────────────────────────────────────────────────────────────────
# VMP_SUPERVISOR_IMAGE=ghcr.io/moltenmarshmallows/vmp-media-pipeline:latest
# VMP_WORKER_IMAGE=ghcr.io/moltenmarshmallows/vmp-encore-worker:latest
